#include <winver.h>
#include "resource.h"

IDI_ZHUYINLLM ICON "zhuyinllm.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040404b0"
        BEGIN
            VALUE "CompanyName", "Texting-AI"
            VALUE "FileDescription", "ZhuyinLLM text service (Zhuyin with on-device AI correction)"
            VALUE "FileVersion", "1.0.0"
            VALUE "ProductName", "ZhuyinLLM"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0404, 1200
    END
END
